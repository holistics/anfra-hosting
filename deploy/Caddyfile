{
	admin off
	auto_https off
	# The hosting platform's proxy ends HTTPS and is the only thing that reaches this port.
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT} {
	# Health checks reach anfra without a login. They show only its version.
	@health path /health
	handle @health {
		reverse_proxy 127.0.0.1:7878 {
			header_up Host {upstream_hostport}
		}
	}

	# The login page and its API (tinyauth v5.2.0 routes).
	@login path /login /logout /continue /totp /forgot-password /unauthorized /error /oidc/authorize /authorize /assets/* /resources/* /api/user/* /api/context/* /api/oauth/* /api/oidc/* /favicon* /apple-touch-icon.png /site.webmanifest /web-app-manifest-* /background.webp
	handle @login {
		reverse_proxy 127.0.0.1:3000
	}

	# Everything else is anfra, for logged-in people and for agents with a password.
	handle {
		forward_auth 127.0.0.1:3000 {
			uri /api/auth/caddy
		}
		reverse_proxy 127.0.0.1:7878 {
			header_up Host {upstream_hostport}
		}
	}
}
