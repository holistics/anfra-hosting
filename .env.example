# Copy to .env (never commit .env). Single quotes keep $ in bcrypt hashes as they are.
PUBLIC_URL=https://data.example.com
LOGIN_USERS='maria:a-long-password,agent:another-long-password'
# Your anfra project's repo, and for a private repo, a token that can read it.
ANFRA_PROJECT_REPO=your-org/your-project
ANFRA_PROJECT_TOKEN=
